{
  "kind": "three simplified presentation diagrams; state names/topology follow existing RTL; no RTL change",
  "pages": [
    {
      "key": "01_core",
      "source": "experiments/parallel8/igor_src_policy_core.v",
      "states": [
        "IDLE",
        "BIAS_ADDRESS",
        "BIAS_WAIT",
        "BIAS_TAKE",
        "WEIGHT_ADDRESS",
        "WEIGHT_WAIT",
        "MAC",
        "ACTIVATE"
      ],
      "transitions": [
        {
          "source": "IDLE",
          "target": "IDLE",
          "label": "!start / load_input sah menyimpan input",
          "diagram_label": "S=0"
        },
        {
          "source": "IDLE",
          "target": "BIAS_ADDRESS",
          "label": "start sah / busy=1; done=0; layer=0; neuron=0",
          "diagram_label": "S=1"
        },
        {
          "source": "BIAS_ADDRESS",
          "target": "BIAS_WAIT",
          "label": "1 clock / alamat bias terdaftar",
          "diagram_label": "1"
        },
        {
          "source": "BIAS_WAIT",
          "target": "BIAS_TAKE",
          "label": "1 clock / data bias siap",
          "diagram_label": "1"
        },
        {
          "source": "BIAS_TAKE",
          "target": "WEIGHT_ADDRESS",
          "label": "1 clock / bias masuk accumulator",
          "diagram_label": "1"
        },
        {
          "source": "WEIGHT_ADDRESS",
          "target": "WEIGHT_WAIT",
          "label": "1 clock / alamat dan operand terdaftar",
          "diagram_label": "1"
        },
        {
          "source": "WEIGHT_WAIT",
          "target": "MAC",
          "label": "1 clock / weights siap",
          "diagram_label": "1"
        },
        {
          "source": "MAC",
          "target": "WEIGHT_ADDRESS",
          "label": "k < input_count-1 / k++",
          "diagram_label": "N=0"
        },
        {
          "source": "MAC",
          "target": "ACTIVATE",
          "label": "k == input_count-1",
          "diagram_label": "N=1"
        },
        {
          "source": "ACTIVATE",
          "target": "BIAS_ADDRESS",
          "label": "neuron+8 < output_count / neuron+=8",
          "diagram_label": "G=0"
        },
        {
          "source": "ACTIVATE",
          "target": "BIAS_ADDRESS",
          "label": "neuron+8 >= output_count && layer!=2 / layer++; neuron=0",
          "diagram_label": "G=1, L=0"
        },
        {
          "source": "ACTIVATE",
          "target": "IDLE",
          "label": "neuron+8 >= output_count && layer==2 / busy=0; done=1",
          "diagram_label": "G=1, L=1"
        }
      ]
    },
    {
      "key": "02_policy",
      "source": "rtl/igor_src_policy/igor_src_policy_uart.v",
      "states": [
        "RX",
        "LOAD",
        "START",
        "RUN",
        "CAP0",
        "CAP1",
        "CAP2",
        "TX",
        "TX_START_LAST",
        "TX_END_LAST"
      ],
      "transitions": [
        {
          "source": "RX",
          "target": "RX",
          "label": "belum ada frame sah",
          "diagram_label": "A=0"
        },
        {
          "source": "RX",
          "target": "LOAD",
          "label": "CRC cocok && seluruh observasi valid / load_index=0",
          "diagram_label": "A=1"
        },
        {
          "source": "LOAD",
          "target": "LOAD",
          "label": "load_index<73 / load_index++",
          "diagram_label": "I=0"
        },
        {
          "source": "LOAD",
          "target": "START",
          "label": "load_index==73 / jadwalkan core_load terakhir",
          "diagram_label": "I=1"
        },
        {
          "source": "START",
          "target": "RUN",
          "label": "1 clock / core_start terdaftar",
          "diagram_label": "1"
        },
        {
          "source": "RUN",
          "target": "RUN",
          "label": "!core_done && tidak ada reject",
          "diagram_label": "D=0"
        },
        {
          "source": "RUN",
          "target": "CAP0",
          "label": "core_done / output_index=0; simpan core_latency",
          "diagram_label": "D=1"
        },
        {
          "source": "CAP0",
          "target": "CAP1",
          "label": "1 clock",
          "diagram_label": "1"
        },
        {
          "source": "CAP1",
          "target": "CAP2",
          "label": "1 clock",
          "diagram_label": "1"
        },
        {
          "source": "CAP2",
          "target": "TX",
          "label": "1 clock / tx_index=0",
          "diagram_label": "1"
        },
        {
          "source": "TX",
          "target": "TX",
          "label": "tx_busy || tx_send: tunggu; slot siap && index<10: index++",
          "diagram_label": "R=0 atau F=0"
        },
        {
          "source": "TX",
          "target": "TX_START_LAST",
          "label": "!tx_busy && !tx_send && tx_index==10 / tx_send=1",
          "diagram_label": "R=1, F=1"
        },
        {
          "source": "TX_START_LAST",
          "target": "TX_START_LAST",
          "label": "!tx_busy",
          "diagram_label": "B=0"
        },
        {
          "source": "TX_START_LAST",
          "target": "TX_END_LAST",
          "label": "tx_busy",
          "diagram_label": "B=1"
        },
        {
          "source": "TX_END_LAST",
          "target": "TX_END_LAST",
          "label": "tx_busy",
          "diagram_label": "B=1"
        },
        {
          "source": "TX_END_LAST",
          "target": "RX",
          "label": "!tx_busy",
          "diagram_label": "B=0"
        }
      ]
    },
    {
      "key": "03_uart_rx",
      "source": "rtl/igor_uart_rx.v",
      "states": [
        "S0",
        "S1",
        "S2",
        "S3"
      ],
      "transitions": [
        {
          "source": "S0",
          "target": "S0",
          "label": "sync=1",
          "diagram_label": "sync=1"
        },
        {
          "source": "S0",
          "target": "S1",
          "label": "sync=0 / count=CLKS_PER_BIT/2-1",
          "diagram_label": "sync=0"
        },
        {
          "source": "S1",
          "target": "S1",
          "label": "count!=0 / count--",
          "diagram_label": "C=0"
        },
        {
          "source": "S1",
          "target": "S2",
          "label": "count==0 && sync==0 / index=0; count=BIT-1",
          "diagram_label": "C=1, sync=0"
        },
        {
          "source": "S1",
          "target": "S0",
          "label": "count==0 && sync==1 / false start",
          "diagram_label": "C=1, sync=1"
        },
        {
          "source": "S2",
          "target": "S2",
          "label": "count!=0: count--; sample && index<7: index++",
          "diagram_label": "C=0 atau K=0"
        },
        {
          "source": "S2",
          "target": "S3",
          "label": "count==0 && bit_index==7 / sample bit terakhir",
          "diagram_label": "C=1, K=1"
        },
        {
          "source": "S3",
          "target": "S3",
          "label": "count!=0 / count--",
          "diagram_label": "C=0"
        },
        {
          "source": "S3",
          "target": "S0",
          "label": "count==0 && sync==1 / valid=1; data[7:0]=shift",
          "diagram_label": "C=1, sync=1"
        },
        {
          "source": "S3",
          "target": "S0",
          "label": "count==0 && sync==0 / error=1",
          "diagram_label": "C=1, sync=0"
        }
      ]
    }
  ],
